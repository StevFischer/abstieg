; Engine configuration file.
config_version=5

[application]

config/name="Abstieg"
config/description="Descent-artiger Minen-Crawler mit endlos vielen prozedural erzeugten Leveln"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Protokoll="*res://scripts/Protokoll.gd"
Eingabe="*res://scripts/Eingabe.gd"
Meta="*res://scripts/Meta.gd"
Klang="*res://scripts/Klang.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/handheld/orientation=0

[rendering]

anti_aliasing/quality/msaa_3d=2
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_3d.mobile=0
scaling_3d/scale.mobile=0.75
textures/vram_compression/import_etc2_astc=true
